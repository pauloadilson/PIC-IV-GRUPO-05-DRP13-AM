# Caminho para o pacote de 48 estimadores HGB (TU)
ML_MODEL_PACKAGE_PATH=resultados_modelagem/comparacao_final_TU/pacote_hgb_TU_48_api.joblib

# Porta de execução da API de Aprendizagem de Máquina
PORTA_ML_API=8001

# Autenticação por chave de API (opcional)
VALIDAR_ML_API_KEY=false
ML_API_KEY=

# Limite máximo de atraso (em minutos) da última observação da janela de 24h
ML_MAX_OBSERVATION_AGE_MINUTES=180
ML_MAX_FUTURE_TOLERANCE_MINUTES=15
ML_ENFORCE_OBSERVATION_AGE=true

